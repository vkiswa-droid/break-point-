# BREAK POINT — Environment Configuration Template
# Store real credentials in protected OS storage or through the Break Point AI Providers HUD.
# Never commit real API keys to version control.

# Google Gemini API (https://aistudio.google.com/)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API (https://platform.openai.com/)
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API (https://console.anthropic.com/)
VITE_ANTHROPIC_API_KEY=your_claude_api_key_here

# Groq Cloud API (https://console.groq.com/)
VITE_GROQ_API_KEY=your_groq_api_key_here

# Local Ollama Daemon (http://127.0.0.1:11434)
VITE_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Wake Phrase Configuration (Default: "Break Point")
VITE_WAKE_PHRASE="Break Point"
VITE_WAKE_SENSITIVITY=75

# Desktop Shell Config
ELECTRON_ENABLE_LOGGING=false
NODE_ENV=production
